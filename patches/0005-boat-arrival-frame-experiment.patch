+	clearflag FLAG_HIDE_LILYCOVE_HARBOR_SSTIDAL
+	setobjectxyperm LOCALID_LILYCOVE_HARBOR_SS_TIDAL, 15, 9
+	addobject LOCALID_LILYCOVE_HARBOR_SS_TIDAL
+	setflag FLAG_COORDINATOR_BOAT_ARRIVAL_PENDING
+	goto LilycoveCity_Harbor_OnTransitionDone
+LilycoveCity_Harbor_OnTransitionDone:
+	end
+
+LilycoveCity_Harbor_OnFrame:
