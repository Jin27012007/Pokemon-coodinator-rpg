+	setvar VAR_TEMP_0, 0
+	lockall
+	applymovement LOCALID_LILYCOVE_HARBOR_SS_TIDAL, LilycoveCity_Harbor_Movement_InitialArrival
+	waitmovement LOCALID_LILYCOVE_HARBOR_SS_TIDAL
