+	clearflag FLAG_COORDINATOR_BOAT_ARRIVAL_PENDING
+	lockall
+	applymovement LOCALID_LILYCOVE_HARBOR_SS_TIDAL, LilycoveCity_Harbor_Movement_InitialArrival
+	waitmovement LOCALID_LILYCOVE_HARBOR_SS_TIDAL
+	releaseall
+	end
+
+LilycoveCity_Harbor_Movement_InitialArrival:
+	walk_left
+	walk_left
+	walk_left
+	walk_left
+	walk_left
+	walk_left
+	walk_left
+	step_end
